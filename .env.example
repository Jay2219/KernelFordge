# KernelForge Configuration Environment

# Meta Model API (api.meta.ai/v1)
META_MODEL_API_KEY=your_meta_model_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_ARCHITECT=muse-wonder
MODEL_SYNTHESIZER=muse-spark-1.3
MODEL_REFLECTION=muse-spark-1.3

# Baseten Open-Weights Endpoint (inference.baseten.co/v1)
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
MODEL_AUDITOR=meta-models/muse-spark-open-1026

# Fallback Provider (Used if Meta API encounters rate limits/downtime)
FALLBACK_MODE=false
FALLBACK_API_KEY=your_fallback_api_key_here
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o

# Execution Sandbox Configuration
# Set MOCK_SANDBOX=true to test the UI and API locally without sending jobs to Modal
MOCK_SANDBOX=true
MODAL_GPU_TARGET=A10G
MODAL_APP_NAME=kernelforge-sandbox

# Server Configuration
PORT=8000
HOST=0.0.0.0

